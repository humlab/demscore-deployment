# Copy to .env and fill in your values.

# PostgreSQL credentials (used by db, web-backend, and mapserver containers)
POSTGRES_PASSWORD=change_me

# WMS tile cache toggle. Controls the server-side nginx tile cache, browser
# service-worker tile cache, and WMS Cache-Control response headers.
# 0 = no-store/pass-through for development, 1 = cache tiles.
DEMSCORE_ENABLE_MAPCACHE=0
