# Copy to .env and fill in your values.

# PostgreSQL credentials (used by db, web-backend, and mapserver containers)
POSTGRES_PASSWORD=change_me

# Host port the router container publishes. This is the one port the whole
# stack exposes; everything else (web, web-backend, mapserver, mapcache) is
# reached through it.
DEMSCORE_ROUTER_PORT=8090

# WMS tile cache toggle. Controls the server-side nginx tile cache, browser
# service-worker tile cache, and WMS Cache-Control response headers.
# 0 = no-store/pass-through for development, 1 = cache tiles.
DEMSCORE_ENABLE_MAPCACHE=0

# Max on-disk size of the server-side nginx tile cache (only applies when
# DEMSCORE_ENABLE_MAPCACHE=1). Accepts nginx proxy_cache_path size suffixes
# (k/m/g). Once exceeded, nginx evicts least-recently-used tiles.
DEMSCORE_MAPCACHE_MAX_SIZE=100g

# How long a cached tile is served as fresh before nginx revalidates it with
# MapServer (only applies when DEMSCORE_ENABLE_MAPCACHE=1). Also sets the
# browser's Cache-Control max-age, so the two stay in step. Plain integer
# seconds. Default 86400 = 24h.
DEMSCORE_MAPCACHE_TTL_SECONDS=86400
